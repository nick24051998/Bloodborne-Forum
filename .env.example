# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# .env is in .gitignore – never commit it.

# --- Forum ------------------------------------------------------------------
# Public URL without a trailing slash. The Discord redirect URL follows from it:
#   ${FORUM_URL}/auth/discord
FORUM_URL=https://forum.example.com
FORUM_TITLE=Bloodborne PC Port Community
# The project website (website/) that the forum links to (without a trailing slash),
# e.g. https://nick24051998.github.io/Bloodborne-Forum
WEBSITE_URL=https://example.com
TZ=Europe/Berlin

# Port and address that Flarum listens on, on the host. 127.0.0.1 = local only
# (production with Tunnel/Caddy). To test on the LAN, enter the host's LAN IP
# and set FORUM_URL to http://<LAN-IP>:<Port> (README → Test on your local network).
FLARUM_BIND=127.0.0.1
FLARUM_PORT=8888
# Image version (https://hub.docker.com/r/crazymax/flarum/tags)
FLARUM_IMAGE_TAG=1.8.19

# --- Database (MariaDB) -------------------------------------------------------
# Long random values, e.g.:  openssl rand -base64 32 | tr -d '/+='
DB_NAME=flarum
DB_USER=flarum
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# --- Admin account ------------------------------------------------------------
# On first start the image creates "flarum"/"flarum". scripts/setup-forum.sh
# replaces this account with the admin defined here. The name may change later in the
# forum (e.g. to the Discord name): the setup then logs in with the email address.
FLARUM_ADMIN_USER=CHANGE_ME_admin
FLARUM_ADMIN_MAIL=admin@example.com
# at least 8 characters
FLARUM_ADMIN_PASS=CHANGE_ME_admin_password

# --- Discord login (fof/oauth) ---------------------------------------------------
# Client ID from the Discord Developer Portal (OAuth2 → Client ID).
# The client SECRET does NOT go here – you enter it in the Flarum admin:
#   Admin → Extensions → FriendsOfFlarum OAuth → Discord → Client Secret
DISCORD_CLIENT_ID=
# Invite link to the Discord server (for the welcome banner and rules)
DISCORD_INVITE_URL=https://discord.gg/WtYT4fXhEN
# true = new accounts only via "Log in with Discord" (email sign-up off)
DISCORD_ONLY_SIGNUP=true

# Discord roles as forum groups (flarum/discord-roles.php): bot token of the forum app (Developer Portal →
# Bot → Reset Token). The bot needs no permissions and no intents on the server, it only has to be a member.
# Empty = off. The token is secret: never in the repo or in chats. After a change, run scripts/setup-forum.sh.
DISCORD_BOT_TOKEN=
# ID of the Discord server
DISCORD_GUILD_ID=1557458508096610446
# Roles with mod permissions in the forum (comma-separated; empty = Owner, Admin and Mod of the BBPP server)
DISCORD_MOD_ROLE_IDS=
# Roles shown as badges in the forum; all other groups are hidden
# (comma-separated; empty = Owner, Admin, Contributor, Mod, Support and Helper of the BBPP server)
DISCORD_SHOWN_ROLE_IDS=
# Roles that can see the Beta area in the forum (comma-separated; empty = Beta Hunter and Test Subject of the BBPP server).
# To grant access in the forum only, you can also use the group "Beta Testers" (Admin → Users → Groups).
DISCORD_BETA_ROLE_IDS=
# GitHub repos whose pre-releases show up as topics in the Beta area (empty = nick24051998/bloodborne_pc)
BETA_REPOS=

# --- Logo contest (page forum.bbport.de/logo-contest) --------------------------------
# Submission deadline and end of voting, UTC (empty = 8 and 15 November 2026, 23:59:59). Then run scripts/setup-forum.sh.
# The website shows the dates from website/src/data/contest.js: update them there too.
CONTEST_SUBMIT_UNTIL=
CONTEST_VOTE_UNTIL=
# Entries as cards (logo, name, link) in a read-only Discord channel: that channel's webhook URL.
# Secret, never in the repo. Set it with ~/.proxmox/set-forum-contest-webhook.ps1 (writes it and posts existing entries).
FORUM_CONTEST_WEBHOOK=

# --- "My game account" (flarum/supermedo-account.php) --------------------------------
# Key shared with SuperMedo Server (game.supermedo.com), 64 characters, the same on both sides. Empty = off (no button,
# /supermedo-account answers 404). Secret, never in the repo or in chats. Set it with
# ~/.proxmox/set-forum-supermedo-key.ps1 (writes it and runs scripts/setup-forum.sh).
SUPERMEDO_ACCOUNT_KEY=

# --- Low RAM on the host -----------------------------------------------------------
# -500 = when RAM is full, the kernel kills other containers first instead of forum/database.
# If a container then fails to start ("oom_score_adj: Permission denied"), set it back to 0.
FORUM_OOM_SCORE_ADJ=0

# --- Uploads ----------------------------------------------------------------------
UPLOAD_MAX_SIZE=32M
PHP_MEMORY_LIMIT=256M

# --- Proxy / real visitor IP -------------------------------------------------------
# The forum's own Docker network. Only requests from this network (host proxy via the
# gateway, cloudflared) may set the visitor IP via header. Only change it if
# Docker reports that the network overlaps with another one.
FORUM_SUBNET=10.88.0.0/24
REAL_IP_HEADER=CF-Connecting-IP

# --- Option (b): Cloudflare Tunnel (only if cloudflared is enabled) ------------------
CF_TUNNEL_TOKEN=

# Automatic updates (scripts/install-auto-update.sh): webhook URL of a Discord channel where
# every update reports whether it worked. Leave empty = no notifications.
AUTO_UPDATE_DISCORD_WEBHOOK=

# New forum topics in Discord: webhook URL of a Discord channel (e.g. #forum-feed). Every new topic
# that guests can see shows up there with title, author, tags, the start of the text and a link. Empty = off.
# After a change, run scripts/setup-forum.sh.
FORUM_DISCORD_WEBHOOK=

# Nightly backup (scripts/install-backup.sh): target folder and how many days it keeps backups
BACKUP_DIR=/opt/backups/bloodborne-forum
BACKUP_KEEP_DAYS=14
