# Kopieren nach .env und ausfüllen:  cp .env.example .env && chmod 600 .env
# .env ist in .gitignore – niemals committen.

# --- Forum ------------------------------------------------------------------
# Öffentliche URL ohne Slash am Ende. Daraus ergibt sich die Discord-Redirect-URL:
#   ${FORUM_URL}/auth/discord
FORUM_URL=https://forum.example.com
FORUM_TITLE=Bloodborne PC Port Community
# Die Projekt-Website (website/), auf die das Forum verlinkt (ohne Slash am Ende),
# z. B. https://nick24051998.github.io/Bloodborne-Forum
WEBSITE_URL=https://example.com
TZ=Europe/Berlin

# Port und Adresse, auf der Flarum auf dem Host lauscht. 127.0.0.1 = nur lokal
# (Produktion mit Tunnel/Caddy). Zum Testen im LAN die LAN-IP des Hosts eintragen
# und FORUM_URL auf http://<LAN-IP>:<Port> setzen (README → Lokal im Netzwerk testen).
FLARUM_BIND=127.0.0.1
FLARUM_PORT=8888
# Image-Version (https://hub.docker.com/r/crazymax/flarum/tags)
FLARUM_IMAGE_TAG=1.8.19

# --- Datenbank (MariaDB) ------------------------------------------------------
# Lange Zufallswerte, z. B.:  openssl rand -base64 32 | tr -d '/+='
DB_NAME=flarum
DB_USER=flarum
DB_PASSWORD=CHANGE_ME_db_password
DB_ROOT_PASSWORD=CHANGE_ME_db_root_password

# --- Admin-Account ------------------------------------------------------------
# Das Image legt beim ersten Start "flarum"/"flarum" an. scripts/setup-forum.sh
# ersetzt diesen Account durch den hier definierten Admin.
FLARUM_ADMIN_USER=CHANGE_ME_admin
FLARUM_ADMIN_MAIL=admin@example.com
# mindestens 8 Zeichen
FLARUM_ADMIN_PASS=CHANGE_ME_admin_password

# --- Discord-Login (fof/oauth) ---------------------------------------------------
# Client ID aus dem Discord Developer Portal (OAuth2 → Client ID).
# Das Client SECRET gehört NICHT hierher – das trägst du im Flarum-Admin ein:
#   Admin → Extensions → FriendsOfFlarum OAuth → Discord → Client Secret
DISCORD_CLIENT_ID=
# Einladungslink zum Discord-Server (für Welcome-Banner und Regeln)
DISCORD_INVITE_URL=https://discord.gg/yTMG8c4Bqm
# true = neue Accounts nur über "Log in with Discord" (E-Mail-Registrierung aus)
DISCORD_ONLY_SIGNUP=true

# --- RAM-Knappheit auf dem Host ----------------------------------------------------
# -500 = Kernel beendet bei vollem RAM zuerst andere Container statt Forum/Datenbank.
# Startet ein Container danach nicht ("oom_score_adj: Permission denied"), zurück auf 0.
FORUM_OOM_SCORE_ADJ=0

# --- Uploads ----------------------------------------------------------------------
UPLOAD_MAX_SIZE=32M
PHP_MEMORY_LIMIT=256M

# --- Proxy / echte Besucher-IP -----------------------------------------------------
# Eigenes Docker-Netz des Forums. Nur Anfragen aus diesem Netz (Host-Proxy über das
# Gateway, cloudflared) dürfen die Besucher-IP per Header setzen. Nur ändern, wenn
# Docker meldet, dass sich das Netz mit einem anderen überschneidet.
FORUM_SUBNET=10.88.0.0/24
REAL_IP_HEADER=CF-Connecting-IP

# --- Variante (b): Cloudflare Tunnel (nur wenn cloudflared aktiviert ist) --------------
CF_TUNNEL_TOKEN=
