---
// Erzeugt /install/, /changelog/, /contact/, /privacy/ aus src/texts/*.md
// (faq.md hat eine eigene Seite, showcase.md liefert nur die Texte der Galerie auf der Startseite)
import Page from '../layouts/Page.astro';
import HardwareCheck from '../components/HardwareCheck.astro';

export function getStaticPaths() {
  const texts = import.meta.glob('../texts/*.md', { eager: true });
  return Object.entries(texts)
    .map(([file, mod]) => ({ page: file.split('/').pop().replace(/\.md$/, ''), mod }))
    .filter(({ page }) => !['faq', 'showcase'].includes(page))
    .map(({ page, mod }) => ({ params: { page }, props: { mod } }));
}

const { mod } = Astro.props;
const { Content, frontmatter } = mod;

// <div data-hwcheck></div> im Text markiert die Stelle für den Hardware-Check (install.md)
const MARK = '<div data-hwcheck></div>';
const html = await mod.compiledContent();
const [before, after] = html.includes(MARK) ? html.split(MARK) : [];
---

<Page frontmatter={frontmatter}>
  {before !== undefined ? (
    <>
      <Fragment set:html={before} />
      <HardwareCheck />
      <Fragment set:html={after} />
    </>
  ) : (
    <Content />
  )}
</Page>
