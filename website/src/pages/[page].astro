---
// Generates /install/, /guide/, /changelog/, /contact/, /privacy/, /tool/ from src/texts/*.md
// (faq.md has its own page, showcase.md only supplies the texts of the gallery on the home page)
import Page from '../layouts/Page.astro';
import HardwareCheck from '../components/HardwareCheck.astro';
import Releases from '../components/Releases.astro';
import { withDownloadLinks } from '../lib/releases.js';

export function getStaticPaths() {
  const texts = import.meta.glob('../texts/*.md', { eager: true });
  return Object.entries(texts)
    .map(([file, mod]) => ({ page: file.split('/').pop().replace(/\.md$/, ''), mod }))
    .filter(({ page }) => !['faq', 'showcase'].includes(page))
    .map(({ page, mod }) => ({ params: { page }, props: { mod } }));
}

const { mod } = Astro.props;
const { frontmatter } = mod;

// Building blocks in the text: <div data-hwcheck></div> (install.md), <div data-release-latest></div> and
// <div data-release-list></div> (changelog.md). The text is split there and the block is inserted.
// Links to "#latest-download" become the ZIP of the latest version.
const html = withDownloadLinks(await mod.compiledContent());
const parts = html.split(/<div data-([a-z-]+)><\/div>/);
---

<Page frontmatter={frontmatter}>
  {parts.map((part, i) =>
    i % 2 === 0 ? <Fragment set:html={part} />
    : part === 'hwcheck' ? <HardwareCheck />
    : part === 'release-latest' ? <Releases show="latest" />
    : part === 'release-list' ? <Releases show="list" />
    : null)}
</Page>
