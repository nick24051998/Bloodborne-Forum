---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Showcase from '../components/Showcase.astro';
import { Image, getImage } from 'astro:assets';
import launcherPlay from '../assets/launcher/launcher-play.png';
import { SITE } from '../../site.config.mjs';
import { link, absolute } from '../lib/url.js';
import { latest, downloadUrl, formatDate, downloads, downloadsText, playersText } from '../lib/releases.js';
import { CONTEST, contestDates, contestRunning } from '../data/contest.js';

// Home page texts. Icons: names from media/icons (gauge, bell, key, anvil, moon, …)
const features = [
  {
    icon: 'gauge',
    title: 'High frame rates, sharp image',
    text: '60, 90 or unlocked FPS, output from 720p to 4K, NVIDIA DLSS and AMD FSR 3.1/4, and frame generation that turns 60 FPS into 120 or more.',
  },
  {
    icon: 'bell',
    title: 'Online co-op',
    text: "Ring the bells and play with other hunters through The Hunter's Dream. You sign in with Discord in the launcher, no extra programs needed.",
  },
  {
    icon: 'key',
    title: 'Everything in one launcher',
    text: 'Controller, keyboard and mouse with free key mapping, mods, game effects, cheats and one-click updates, in 12 languages. The field of view is in the in-game menu.',
  },
  { icon: 'anvil', title: 'Mods & patches', text: 'Share and discuss mods, patches and tweaks with the community.' },
];

const helpUrl = SITE.forumUrl ? `${SITE.forumUrl}/t/help-support` : SITE.discordUrl;

// SuperMedo Server, a band below the hero: the forum asks the server once a minute (flarum/server-stats.php)
const serverUrl = SITE.forumUrl ? `${SITE.forumUrl}/api/bb-server/summary` : '';

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: `${SITE.name} Community`,
  url: absolute(),
  logo: absolute('favicon.png'),
  ...(([SITE.forumUrl, SITE.discordUrl, SITE.githubUrl].filter(Boolean).length) && {
    sameAs: [SITE.forumUrl, SITE.discordUrl, SITE.githubUrl].filter(Boolean),
  }),
};

// Full-size image of the Play page for clicking the preview ("what the real launcher looks like")
const launcherFull = await getImage({ src: launcherPlay, format: 'webp', quality: 90 });

// The port itself, so Google connects "bbport" with this site, Supermedo and the download
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: `${SITE.portName} (${SITE.brand})`,
  alternateName: [SITE.brand, SITE.name],
  applicationCategory: 'GameApplication',
  operatingSystem: 'Windows 10, Windows 11',
  url: absolute(),
  ...(latest && { softwareVersion: latest.version, datePublished: latest.date }),
  ...(downloadUrl && { downloadUrl }),
  ...(SITE.portAuthor && { author: { '@type': 'Person', name: SITE.portAuthor, url: SITE.portAuthorUrl } }),
  ...(SITE.portRepoUrl && { codeRepository: SITE.portRepoUrl }),
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(downloads && {
    interactionStatistic: { '@type': 'InteractionCounter', interactionType: 'https://schema.org/DownloadAction', userInteractionCount: downloads },
  }),
};
---

<Base jsonLd={[orgLd, appLd]}>
  <div class="wip-bar">
    <p class="container">
      <span class="wip-tag">Work in progress</span>
      <span>
        This site is still being built. Bug hunters may keep every bug they find, but please report it
        {SITE.discordUrl ? <> on <a href={SITE.discordUrl} rel="noopener">Discord</a>.</> : ' in the forum.'}
      </span>
    </p>
  </div>
  <section class="hero">
    <div class="container">
      <div>
        <p class="eyebrow">{SITE.brand} · Community hub</p>
        <h1>{SITE.name}</h1>
        <p class="lead">
          bbport brings the original PS4 game natively to Windows 10 and 11 – at 60 FPS or more, in up to 4K, with
          online co-op.
        </p>
        {downloadsText && (
          <p class="hero-stat">
            {playersText && (
              <span class="hero-stat-item" title="Downloads of the most downloaded version">
                <strong class="hero-players">{playersText}</strong>
                <span>players</span>
              </span>
            )}
            <span class="hero-stat-item" title="All versions together, launcher updates included">
              <strong class="hero-downloads">{downloadsText}</strong>
              <span>downloads</span>
            </span>
          </p>
        )}
        <div class="actions">
          <a class="btn btn-primary" href={link('install/')}>Install guide</a>
          {downloadUrl && <a class="btn btn-ghost hero-download-btn" href={downloadUrl} rel="noopener">Download{latest && ` ${latest.version}`}</a>}
          {SITE.discordUrl && <a class="btn btn-discord" href={SITE.discordUrl} rel="noopener"><Icon name="discord" />Join Discord</a>}
          {SITE.forumUrl && <a class="btn btn-ghost" href={SITE.forumUrl}>Visit forum</a>}
        </div>
        {latest?.download && (
          <p class="hero-download">
            {latest.downloadName}, {latest.downloadSize} MB, released {formatDate(latest.date)}
            <span aria-hidden="true"> · </span>
            <a href={link('changelog/')}>What's new</a>
          </p>
        )}
        {SITE.portRepoUrl && (
          <p class="hero-port">
            The community for <strong>{SITE.portName}</strong> ({SITE.brand}) by{' '}
            <a href={SITE.portAuthorUrl} rel="noopener">{SITE.portAuthor}</a>
            <span aria-hidden="true"> · </span>
            <a href={SITE.portRepoUrl} rel="noopener">Source code on GitHub</a>
          </p>
        )}
      </div>
      <div class="emblem">
        <div class="emblem-art">
          <img class="emblem-blood" src={link('emblem-blood.webp')} alt="" width="380" height="433" />
          <img class="emblem-bone" src={link('emblem-bone.webp')} alt="" width="380" height="433" />
        </div>
      </div>
    </div>
  </section>

  {serverUrl && (
    <section class="srv-band" data-src={serverUrl} aria-label="SuperMedo Server right now" hidden>
      <div class="container">
        <p class="srv-band-name">
          <span class="sm-lamp" aria-hidden="true"></span>
          <span><span class="srv-band-title">SuperMedo Server</span><span data-field="state"></span></span>
        </p>
        <p class="srv-band-stat"><strong data-field="online">0</strong><span>Online now</span></p>
        <p class="srv-band-stat"><strong data-field="peak">0</strong><span>Record</span></p>
        <p class="srv-band-stat"><strong data-field="played">0</strong><span>Played today</span></p>
        <p class="srv-band-fact" data-field="fastest"></p>
        <a class="btn btn-ghost" href={link('server/')}>Full statistics</a>
      </div>
    </section>
  )}

  <script>
    // Fills the SuperMedo Server band; without data (forum or server unreachable) it stays hidden
    const band = document.querySelector<HTMLElement>('.srv-band');
    if (band) {
      const field = (name: string) => band.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
      const number = (value: number) => Number(value ?? 0).toLocaleString('en-US');

      const load = async () => {
        try {
          const response = await fetch(band.dataset.src!, { credentials: 'omit' });
          if (!response.ok) return;
          const d = await response.json();
          const awake = d.status === 'online';
          band.classList.toggle('is-awake', awake);
          const since = new Date(d.awakeSince * 1000).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
          const bells = d.bells ?? {};
          // In its first 30 days the server is called new, so its numbers are read as a young server's (Nick, 29.10.2026)
          const fresh = d.countingSince && Date.now() / 1000 - d.countingSince < 30 * 86400;
          const opened = new Date(d.countingSince * 1000).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
          field('state').textContent = !awake ? 'Resting for maintenance'
            : fresh ? `New since ${opened}${d.registered ? `, ${number(d.registered)} hunters joined` : ''}`
            : bells.hosts_searching ? `Online since ${since}, ${number(bells.hosts_searching)} ${bells.hosts_searching === 1 ? 'host wants' : 'hosts want'} help`
            : `Online since ${since}, no bells ringing`;
          field('online').textContent = number(d.online);
          field('peak').textContent = number(d.peakEver);
          field('played').textContent = number(d.playedToday);
          const fastest = field('fastest');
          fastest.replaceChildren();
          if (d.fastest) {
            const name = document.createElement('strong');
            name.textContent = d.fastest.name;
            fastest.append('Kills fastest: ', name, `, ${number(d.fastest.deaths)} deaths in ${number(d.fastest.minutes)} min`);
          }
          band.hidden = false;
        } catch {
          // Network error: the band stays as it is
        }
      };

      load();
      // While the page is visible, refresh every minute (the forum also caches for one minute)
      setInterval(() => {
        if (document.visibilityState === 'visible') load();
      }, 60000);
    }
  </script>

  {contestRunning && (
    <section class="contest-banner" id="logo-contest" aria-labelledby="contest-heading">
      <div class="container">
        <div class="contest-text">
          <p class="eyebrow">Community contest</p>
          <h2 id="contest-heading">Design the new launcher logo</h2>
          <p class="contest-lead">
            The {SITE.brand} launcher gets a new logo, and you can make it. Send in your design, then everyone with a
            forum account votes. The winning design becomes the new launcher logo, credited with your name.
          </p>
          <ul class="contest-dates">
            <li><strong>Entries</strong> until {contestDates.submit}</li>
            <li><strong>Voting</strong> {contestDates.voteFrom} – {contestDates.vote}</li>
          </ul>
          <p class="contest-specs"><span>SVG or PNG</span><span>1024 × 1024</span><span>Transparent background</span><span>Readable at 32 px</span></p>
          <div class="actions">
            <a class="btn btn-primary" href={CONTEST.page}>Enter the contest</a>
            <a class="btn btn-ghost" href={link(CONTEST.template)} download="logo-contest-template.svg">Download the template</a>
          </div>
        </div>
        <a class="contest-sigil" href={CONTEST.page} aria-label="See the entries and vote in the forum">
          <img src={link('emblem-bone.webp')} alt="" width="380" height="433" loading="lazy" />
          <span class="contest-mark" aria-hidden="true">?</span>
          <span class="contest-slot">Your logo here</span>
        </a>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2>What you get</h2>
      <p class="about">
        Bloodborne for Windows runs the original PlayStation 4 game natively on Windows 10 and 11. It is not an
        emulator: the game's own x86-64 code runs directly on your PC, and its graphics are translated to Vulkan. Unpack
        the zip, pick your game folder and press PLAY, and you get Bloodborne at 60 FPS or more, in up to 4K, with DLSS
        or FSR, frame generation and online co-op. It's free and open source, made by{' '}
        <a href={SITE.portAuthorUrl} rel="noopener">{SITE.portAuthor}</a> and built on bbport and the shadPS4 renderer.
        Code, releases and release notes are on <a href={SITE.portRepoUrl} rel="noopener">GitHub</a>; download it only
        from there. This site and the forum are run by the community around the port.
      </p>
      <div class="grid">
        {features.map((f) => (
          <div class="card">
            <Icon name={f.icon} class="icon" />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt launcher" id="launcher">
    <div class="container">
      <h2>The official launcher</h2>
      <p class="about">
        This is what the real launcher of {SITE.portName} ({SITE.brand}) looks like: the Play page with the ready check,
        your goal and the big PLAY button, and Picture &amp; performance, Online play, Saves, Mods and Help in the side
        bar. It comes in the download from this site or from {SITE.portAuthor}'s GitHub releases. A launcher that looks
        different, or a download from another site, is not ours.
      </p>
      <a class="launcher-shot" href={launcherFull.src} aria-label="Open the launcher screenshot in full size">
        <Image src={launcherPlay} alt="The launcher's Play page: ready check, your goal (Smooth, Balanced, Quiet), controller or keyboard and mouse, Fullscreen and Play online switches, and the PLAY button"
          widths={[700, 1000, 1380]} sizes="(max-width: 1180px) 100vw, 1100px" loading="lazy" />
      </a>
      <p class="launcher-caption">
        The Play page. How each page works: <a href={link('guide/')}>launcher</a>.
      </p>
    </div>
  </section>

  <Showcase />

  <section class="section nr-teaser" id="supermedo">
    <div class="container">
      <div class="nr-next">
        <div>
          <p class="nr-prompt" aria-hidden="true">C:\BBPORT&gt; cd ..\{SITE.portAuthor.toUpperCase()}</p>
          <h2>More from {SITE.portAuthor}</h2>
          <p>
            {SITE.brand} is one of his ports. Uncharted, WET, Prince of Persia 2, Commander Keen and more run natively on
            Windows too, collected on his site NativeRetro.
          </p>
        </div>
        <div class="nr-actions">
          <a class="btn btn-ghost" href={link('supermedo/')}>See all his ports</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container grid">
      <div>
        <h2 style="margin-top:0">Get started</h2>
        <p>Check the system requirements, follow the step-by-step install guide and you are ready to hunt. New to all this? The best settings page shows the first start screen by screen.</p>
        <p class="get-started-actions">
          <a class="btn btn-primary" href={link('install/')}>Read the install guide</a>
          <a class="btn btn-ghost" href={link('best-settings/')}>Best settings</a>
        </p>
      </div>
      <div>
        <h2 style="margin-top:0">Need help?</h2>
        <p>
          Read the <a href={link('faq/')}>FAQ</a> first – most problems are covered there. When you ask for help, include
          your port version, GPU and driver, what happens and your report zip (launcher: Help → Save a report).
        </p>
        {helpUrl && <p><a class="btn btn-ghost" href={helpUrl} rel="noopener">{SITE.forumUrl ? 'Open the forum' : 'Ask on Discord'}</a></p>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="notice">
        <strong>No game files, ever.</strong> You need your own legally obtained copy of Bloodborne. We do not provide,
        request or link to game files, and posts that do are removed.
      </div>
    </div>
  </section>
</Base>
