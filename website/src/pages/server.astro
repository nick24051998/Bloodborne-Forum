---
// Online (menu item "Online", Nick 29.10.2026): how to play online, then what happens on SuperMedo Server,
// Supermedo's own online server. The numbers come from the forum (SITE.forumUrl + '/api/bb-server',
// flarum/server-stats.php), which asks SuperMedo Server once a minute: visitors' addresses stay with us and the
// server isn't asked once per visitor. Online IDs as the server shows them. The address stays /server/.
import Base from '../layouts/Base.astro';
import { SITE } from '../../site.config.mjs';
import { link } from '../lib/url.js';

const api = SITE.forumUrl ? `${SITE.forumUrl}/api/bb-server` : '';
const toc = [
  ['play', 'Play online'], ['now', 'Right now'], ['map', 'Map'], ['deaths', 'Where hunters die'], ['pvp', 'Invasions'],
  ['hunt', 'The hunt'], ['boards', 'Leaderboards'], ['community', 'Messages and glyphs'], ['day', 'Day by day'],
  ['hunters', 'Hunters'],
];
---

<Base
  title="Online play & SuperMedo Server"
  description={`How to play ${SITE.portName} online, and what happens on SuperMedo Server: who is online, where hunters die, best messages and leaderboards.`}
>
  <section class="page-hero">
    <div class="container sm-hero">
      <p class="eyebrow">Play together</p>
      <h1>Online</h1>
      <p class="sm-lead">
        Co-op, invasions and messages from other hunters: how to get online, and what happens right now on SuperMedo
        Server, the online server run by {SITE.portAuthor}.
      </p>
      <p class="sm-state"><span class="sm-lamp" aria-hidden="true"></span><span data-field="state">Asking SuperMedo Server…</span></p>
      <nav class="sm-toc" aria-label="On this page">
        {toc.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </div>
  </section>

  <!-- Folded (Nick, 29.10.2026): the heading and one line say what is inside, the live numbers below come sooner.
       Links to #play (FAQ, install guide, launcher page, "On this page") open it. Inside, the steps are the main thing:
       the wide column, with the buttons where the steps end; the help for when it doesn't connect is the narrower
       column beside it, both start on the same line. -->
  <section class="section section-alt sm-play" id="play" aria-labelledby="play-h">
    <details class="container sm-guide" data-field="guide">
      <summary>
        <span>
          <h2 id="play-h">Play online</h2>
          <span class="sm-guide-hint">Three steps in the launcher, and what to do when it doesn't connect.</span>
        </span>
      </summary>
      <div class="sm-play-grid">
        <div>
          <ol class="sm-steps">
            <li>In the launcher, open <strong>Online play</strong> and tick <strong>Play online</strong>.</li>
            <li>
              Sign in to <strong>SuperMedo Server</strong>, {SITE.portAuthor}'s own server and the port's only one since
              1.9.7 (the numbers below come from it): with Discord, or <a href={`${SITE.superMedoAccountUrl}/register`} rel="noopener">make a free account</a>.
            </li>
            <li>Press <strong>Test connection</strong>, then PLAY, and choose online at the title screen. Ring a bell.</li>
          </ol>
          <p class="sm-play-note">
            Everyone in a session needs game version 1.09 and the same server. Friends behind the same internet
            connection, on the same Wi-Fi for example, play together over their home network. Bells, password and region for
            playing with a friend: <a href={link('faq/#friend')}>the checklist</a>. Questions about the port go to our forum
            or Discord.
          </p>
          <div class="sm-actions">
            <a class="btn btn-primary" href={SITE.downloadUrl} rel="noopener">Download</a>
            <a class="btn btn-ghost" href={`${SITE.superMedoAccountUrl}/register`} rel="noopener">SuperMedo Server account</a>
          </div>
          <p class="sm-small">
            Forgot your SuperMedo Server password?{' '}
            <a href={`${SITE.superMedoAccountUrl}/forgot`} rel="noopener">Get a new one by email</a>.
          </p>
        </div>
        <aside class="sm-play-help" aria-labelledby="help-h">
          <h3 id="help-h" class="sm-label">It doesn't connect?</h3>
          <ul class="sm-tips">
            <li><strong>Update to the newest version.</strong> From 1.9.5 on the launcher opens your router's port by itself, goes through SuperMedo Server's relay when a router blocks a direct connection, and signs in past expired certificates in Windows.</li>
            <li><strong>"Failed to acquire Bloodborne server information":</strong> fixed since 1.9.4, also on PCs whose antivirus scans HTTPS connections.</li>
            <li><strong>Certificate or date error at sign-in:</strong> check your PC's clock, a wrong date breaks the sign-in.</li>
            <li><strong>shadNet:</strong> shadPS4's public shadNet server doesn't accept the port, and from 1.9.5 on your own servers can't be chosen any more. Choose SuperMedo Server.</li>
            <li><strong>Seamless co-op (BBSC):</strong> from 1.9.5 on its own start plays its own save, separate from your characters, and normal online works again afterwards.</li>
            <li><strong>The Hunter's Dream:</strong> no longer offered from 1.9.7 on. The launcher moves you to SuperMedo Server by itself; sign in there once.</li>
            <li>More in the <a href={link('faq/#online-connection')}>FAQ</a>.</li>
          </ul>
        </aside>
      </div>
    </details>
  </section>

  <script>
    // The guide is folded; a link to #play opens it, also a second click on "Play online" in "On this page"
    const guide = document.querySelector<HTMLDetailsElement>('.sm-guide');
    if (guide) {
      const open = () => { if (location.hash === '#play') guide.open = true; };
      open();
      window.addEventListener('hashchange', open);
      document.querySelectorAll('a[href="#play"]').forEach((a) => a.addEventListener('click', () => { guide.open = true; }));
    }
  </script>

  <!-- Dashboard (Nick, 29.10.2026): the numbers in one strip first, then short lists in panels side by side, each with a
       bar in brass (time) or blood (deaths). The full tables stay one click away. -->
  <div class="sm-page" data-src={api} data-hunter={link('server/hunter/')}>
    <section class="section" id="now" aria-labelledby="now-h">
      <div class="container">
        <p class="eyebrow">SuperMedo Server, live</p>
        <h2 id="now-h">Right now</h2>
        <p class="sm-fresh" data-field="fresh" hidden></p>
        <dl class="sm-strip">
          <div><dt>Hunters online</dt><dd><strong data-field="online">–</strong><span data-field="peaks"></span></dd></div>
          <div><dt>Hunters today</dt><dd><strong data-field="today">–</strong><span data-field="todaySub"></span></dd></div>
          <div><dt>Bells rung</dt><dd><strong data-field="bells24">–</strong><span data-field="bellsSub"></span></dd></div>
          <div><dt>Deaths</dt><dd><strong class="is-blood" data-field="deaths24">–</strong><span data-field="deathsSub"></span></dd></div>
          <div><dt>Hours played</dt><dd><strong data-field="hours24">–</strong><span data-field="hoursSub"></span></dd></div>
          <div><dt>Messages</dt><dd><strong data-field="messages24">–</strong><span data-field="messagesSub"></span></dd></div>
        </dl>
        <div class="sm-grid">
          <article class="sm-panel" aria-labelledby="where-h">
            <header><h3 id="where-h">Where hunters are now</h3><span data-field="whereCount"></span></header>
            <p class="sm-intro" data-field="where" aria-live="polite"></p>
            <ul class="sm-rows" data-field="whereRows"></ul>
          </article>
          <div class="sm-stack">
            <div class="sm-monitor">
              <div class="sm-screen">
                <p class="sm-prompt">C:\SUPERMEDO&gt; bells</p>
                <p><span>Hosts want help</span><span data-field="hosts">–</span></p>
                <p><span>Helpers waiting</span><span data-field="helpers">–</span></p>
                <p><span>Invaders</span><span data-field="invaders">–</span></p>
                <p class="sm-advice" data-field="advice">&gt; waiting for the server</p>
              </div>
            </div>
          </div>
        </div>
        {/* Hunters online right now as dots without names on the ground of one area (Nick, 1.11.2026); "Coming soon"
            while SuperMedo Server doesn't send where they are */}
        <article class="sm-panel sm-map-panel" id="map" aria-labelledby="map-h">
          <header>
            <h3 id="map-h">Hunters on the map</h3>
            <select class="sm-pick" data-field="mapArea" aria-label="Area" hidden></select>
          </header>
          <div class="sm-map" data-field="map"></div>
          <p class="sm-small" data-field="mapNote" hidden>Every dot is a hunter online right now, without a name. The ground is where hunters have walked.</p>
          <div class="sm-tiles" data-field="mapTiles" hidden></div>
        </article>
      </div>
    </section>

    <section class="section section-alt" id="deaths" aria-labelledby="deaths-h">
      <div class="container">
        <h2 id="deaths-h">Where hunters die</h2>
        <div class="sm-grid sm-grid-even">
          <article class="sm-panel" aria-labelledby="fall-h">
            <header><h3 id="fall-h">Fastest deaths</h3><span>deaths per hour played</span></header>
            <p class="sm-intro" data-field="areaFacts"></p>
            <ul class="sm-rows" data-field="fallRows"></ul>
            <details class="sm-fold">
              <summary>All areas in numbers</summary>
              <div class="sm-scroll">
                <table class="sm-table">
                  <thead><tr><th scope="col">Area, most played first</th><th scope="col">Here now</th><th scope="col">Hours</th><th scope="col">Deaths</th><th scope="col" class="sm-wide">Deaths per hour</th><th scope="col">Bells</th><th scope="col">Messages</th><th scope="col">Footsteps</th></tr></thead>
                  <tbody data-field="areas"></tbody>
                </table>
              </div>
              <p class="sm-small">Deaths per hour only for areas with at least 30 minutes played, so one unlucky visit doesn't top the list. A footstep is about a minute a hunter spent there.</p>
            </details>
          </article>
          <article class="sm-panel" aria-labelledby="kill-h">
            <header><h3 id="kill-h">What kills hunters</h3><span data-field="causesHead"></span></header>
            <div class="sm-causes" data-field="causes"></div>
            <ol class="sm-rows" data-field="killers"></ol>
            <h4 class="sm-label">Latest deaths</h4>
            <ul class="sm-list" data-field="deaths"></ul>
          </article>
        </div>
      </div>
    </section>

    <!-- Invasions and the hunt (Nick, 1.11.2026): SuperMedo Server counts them since 1 Nov; every part says
         "Coming soon" until its numbers come -->
    <section class="section" id="pvp" aria-labelledby="pvp-h">
      <div class="container">
        <h2 id="pvp-h">Invasions</h2>
        <div class="sm-grid sm-grid-even">
          <article class="sm-panel" aria-labelledby="ends-h">
            <header><h3 id="ends-h">How invasions end</h3><span data-field="pvpSince"></span></header>
            <div data-field="pvpEnds"></div>
            <h4 class="sm-label">Latest fights</h4>
            <ul class="sm-list" data-field="pvpRecent"></ul>
          </article>
          <article class="sm-panel" aria-labelledby="duels-h">
            <header><h3 id="duels-h">Invaders and defenders</h3><span>the best on the server</span></header>
            <div class="sm-tabs" role="group" aria-label="Pick a list" data-field="pvpTabs"></div>
            <ol class="sm-rows" data-field="pvpBoard"></ol>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="hunt" aria-labelledby="hunt-h">
      <div class="container">
        <h2 id="hunt-h">The hunt</h2>
        <dl class="sm-strip" data-field="deeds"></dl>
        <div data-field="deedsMore"></div>
        <div class="sm-grid sm-grid-even">
          <article class="sm-panel" aria-labelledby="beasts-h">
            <header><h3 id="beasts-h">Beasts slain</h3><span data-field="beastsHead"></span></header>
            <ol class="sm-rows" data-field="beasts"></ol>
            <h4 class="sm-label">Where</h4>
            <ul class="sm-rows" data-field="beastAreas"></ul>
          </article>
          <article class="sm-panel" aria-labelledby="bosses-h">
            <header><h3 id="bosses-h">Bosses</h3><span data-field="bossesHead"></span></header>
            <ol class="sm-rows" data-field="bosses"></ol>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="boards" aria-labelledby="boards-h">
      <div class="container">
        <article class="sm-panel">
          <header><h2 id="boards-h">Leaderboards</h2><span>the top hunters on the server</span></header>
          <div class="sm-tabs" role="group" aria-label="Pick a leaderboard" data-field="boardTabs"></div>
          <div class="sm-period" role="group" aria-label="Time range">
            <button type="button" data-period="all" aria-pressed="true">All time</button>
            <button type="button" data-period="week" aria-pressed="false">This week</button>
          </div>
          <ol class="sm-board" data-field="board"></ol>
        </article>
      </div>
    </section>

    <section class="section section-alt" id="community" aria-labelledby="community-h">
      <div class="container">
        <h2 id="community-h">Messages and glyphs</h2>
        <div class="sm-grid sm-grid-even">
          <article class="sm-panel" aria-labelledby="messages-h">
            <header><h3 id="messages-h">Latest messages</h3><span data-field="messageCount"></span></header>
            <div class="sm-messages" data-field="messages"></div>
          </article>
          <article class="sm-panel" id="chalices" aria-labelledby="chalices-h">
            <header><h3 id="chalices-h">Chalice glyphs</h3><span>newest first</span></header>
            <p class="sm-intro">Enter a glyph at a Ritual Altar to visit the same dungeon.</p>
            <ul class="sm-rows" data-field="chalices"></ul>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="day" aria-labelledby="day-h">
      <div class="container">
        <article class="sm-panel">
          <header><h2 id="day-h">Day by day</h2><span data-field="sinceHead"></span></header>
          <h3 class="sm-label">Hunters online, last 48 hours <span class="sm-label-note" data-field="hourHead"></span></h3>
          <div class="sm-chart" data-field="hourChart"></div>
          <div class="sm-chart-axis" data-field="hourAxis" aria-hidden="true"></div>
          <div class="sm-scroll">
            <table class="sm-table">
              <thead><tr><th scope="col">Day</th><th scope="col" class="sm-wide">Hunters</th><th scope="col">New</th><th scope="col">Most at once</th><th scope="col">Hours</th><th scope="col">Deaths</th></tr></thead>
              <tbody data-field="history"></tbody>
            </table>
          </div>
          <p class="sm-small">Point at a day for its messages, ratings and bells.</p>
        </article>
      </div>
    </section>

    <section class="section section-alt" id="hunters" aria-labelledby="hunters-h">
      <div class="container">
        <div class="sm-head">
          <h2 id="hunters-h">Hunters</h2>
          <p class="sm-counts">
            <span><strong data-field="registered">–</strong> registered</span>
            <span><strong data-field="playedOnline">–</strong> played online</span>
            <span><strong data-field="newWeek">–</strong> new this week</span>
          </p>
        </div>
        {/* The table shows at most 100 of over a thousand hunters: one field opens anybody's page (UX review 29.10.2026) */}
        <form class="sm-find" action={link('server/hunter/')} method="get" role="search">
          <label for="hunter-id">Find a hunter</label>
          <input id="hunter-id" name="id" type="text" placeholder="Online ID" autocomplete="off" spellcheck="false"
            required maxlength="32" pattern="[A-Za-z0-9_\-]{1,32}" title="The Online ID: letters, digits, _ and -" />
          <button class="btn btn-ghost" type="submit">Show</button>
        </form>
        <div class="sm-scroll">
          <table class="sm-table">
            <thead><tr><th scope="col">Online ID, most hours first</th><th scope="col">Level</th><th scope="col">Hours</th><th scope="col">Deaths</th><th scope="col">Helped · hosted</th><th scope="col">Invasions</th><th scope="col">Messages</th><th scope="col">Last seen</th></tr></thead>
            <tbody data-field="hunters"></tbody>
          </table>
        </div>
        <button type="button" class="btn btn-ghost sm-more" data-field="moreHunters" hidden>Show all hunters</button>
      </div>
    </section>

    <p class="container sm-note">
      Refreshed every minute through forum.bbport.de. Hunters appear by their Online ID only; the map shows where hunters
      are, never who. Admins of SuperMedo Server can hide a hunter from these lists.
    </p>
  </div>

  <script>
    import { el, num, hours, when, stamp, openedDay, isNew, place, hunterLink, death, soon } from '../lib/server-stats.js';

    const page = document.querySelector<HTMLElement>('.sm-page');
    if (page && page.dataset.src) {
      const field = (name: string) => document.querySelector<HTMLElement>(`[data-field="${name}"]`)!;
      const set = (name: string, text: string) => { field(name).textContent = text; };
      const hunterUrl = page.dataset.hunter!;
      const boards: [string, string][] = [
        ['minutes_played', 'Hours played'], ['deaths', 'Deaths'], ['messages', 'Messages'], ['ratings_received', 'Good ratings'],
        ['summoned_to_help', 'Helped'], ['summons_hosted', 'Hosted'], ['invasions', 'Invasions'],
      ];
      const causes: Record<string, string> = {
        killed: 'Killed by an enemy or hunter', fall: 'Fell', poison: 'Poison', brainsucker: 'Brainsucker (Insight)', other: 'Something else',
      };
      let data: any = null;
      let board = 'minutes_played';
      let period: 'all' | 'week' = 'all';
      let allHunters = false;

      // One table row; the first `head` cells are row headings
      const row = (cells: (Node | string)[], head = 0) => {
        const tr = document.createElement('tr');
        cells.forEach((c, i) => {
          const td = el(i < head ? 'th' : 'td');
          if (i < head) td.setAttribute('scope', 'row');
          td.append(c);
          tr.append(td);
        });
        return tr;
      };
      const bar = (pct: number, red = false) => {
        const b = el('span', red ? 'sm-bar sm-bar-red' : 'sm-bar');
        const f = el('span');
        f.style.width = `${Math.max(0, Math.min(100, pct))}%`;
        b.append(f);
        return b;
      };
      // One line of a panel: name and number, then a bar and a smaller line when given
      const line = (name: (Node | string)[], value: Node | string, pct?: number, red = false, meta = '') => {
        const li = el('li');
        const head = el('span', 'sm-row-head');
        const label = el('span', 'sm-row-name');
        label.append(...name);
        const figure = el('strong', 'sm-row-value');
        figure.append(value);
        head.append(label, figure);
        li.append(head);
        if (pct !== undefined) li.append(bar(pct, red));
        if (meta) li.append(el('span', 'sm-meta', meta));
        return li;
      };
      const empty = (target: HTMLElement, text: string, cols = 0) => {
        if (cols) {
          const tr = document.createElement('tr');
          const td = el('td', 'sm-empty', text) as HTMLTableCellElement;
          td.colSpan = cols;
          tr.append(td);
          target.replaceChildren(tr);
        } else {
          target.replaceChildren(el(target.tagName === 'OL' || target.tagName === 'UL' ? 'li' : 'p', 'sm-empty', text));
        }
      };

      const renderNow = (s: any) => {
        // In its first 30 days the server is called new, so its numbers are read as a young server's (Nick, 29.10.2026)
        const fresh = field('fresh');
        fresh.hidden = !isNew(data.opened);
        if (!fresh.hidden) {
          set('fresh', `SuperMedo Server is new: it opened on ${openedDay(data.opened)}, and ${num(s.hunters?.registered ?? 0)} hunters have joined since.`);
        }
        set('online', num(s.online));
        const today = s.peak_online?.today;
        const ever = s.peak_online?.ever;
        set('peaks', [today?.online ? `most today ${num(today.online)}, ${when(today.at, true)}` : '',
          ever?.online ? `record ${num(ever.online)}` : ''].filter(Boolean).join(' · '));
        // The areas with hunters in them, the busiest first; the rest of them in one line below
        const here = (data.areas ?? []).filter((a: any) => a.online > 0).sort((a: any, b: any) => b.online - a.online);
        const most = Math.max(1, ...here.map((a: any) => a.online));
        set('whereCount', here.length ? `${num(here.reduce((sum: number, a: any) => sum + a.online, 0))} in Yharnam` : '');
        set('where', here.length ? '' : 'Nobody in Yharnam right now. When hunters are on, the areas they are in show here.');
        const rows = here.slice(0, 7).map((a: any) => line([a.name], `${num(a.online)} now`, (100 * a.online) / most, false,
          `${hours(a.hunter_minutes)} h played · ${num(a.bells_rung)} bells · ${num(a.messages)} messages`));
        if (here.length > 7) rows.push(el('li', 'sm-meta', `Also ${here.slice(7).map((a: any) => `${a.name} (${a.online})`).join(', ')}.`));
        field('whereRows').replaceChildren(...rows);
        const b = s.bells ?? {};
        set('hosts', num(b.hosts_searching ?? 0));
        set('helpers', num(b.helpers ?? 0));
        set('invaders', num(b.invaders ?? 0));
        // What a bell would do right now
        let advice = 'No bells ringing right now.';
        if (s.status !== 'online') advice = 'The server is resting. Bells are quiet until it is back.';
        else if (b.hosts_searching && !b.helpers) advice = `${num(b.hosts_searching)} ${b.hosts_searching === 1 ? 'host wants' : 'hosts want'} help. Ring the Small Resonant Bell to be summoned.`;
        else if (b.helpers && !b.hosts_searching) advice = `${num(b.helpers)} ${b.helpers === 1 ? 'helper is' : 'helpers are'} waiting. Ring the Beckoning Bell and help comes to you.`;
        else if (b.helpers && b.hosts_searching) advice = 'Bells are ringing on both sides. Ring yours, a match is close.';
        if (s.status === 'online' && b.invaders) advice += ` Careful: ${num(b.invaders)} ${b.invaders === 1 ? 'invader is' : 'invaders are'} waiting.`;
        set('advice', `> ${advice}`);
      };

      const renderDay = (s: any) => {
        // The strip: the last 24 hours big, everything since counting began small below
        const d = s.last_24h ?? {};
        const t = s.totals ?? {};
        const since = when(s.counting_since, false, true);
        const wholeHours = (minutes: number) => num(Math.round(Number(minutes ?? 0) / 60));
        // Hunters who played today (UTC, the server's day); yesterday's row doesn't count once the day has turned
        const latest = (data.history ?? [])[0];
        const today = latest?.date === new Date().toISOString().slice(0, 10) ? latest : {};
        set('today', num(today.hunters));
        set('todaySub', `${num(today.new_hunters)} new today`);
        set('bells24', num(d.bells_rung));
        set('bellsSub', `24 h · ${num(t.bells_rung)} since ${since}`);
        set('deaths24', num(d.deaths));
        set('deathsSub', `24 h · ${num(t.deaths)} since ${since}`);
        set('hours24', wholeHours(d.hunter_minutes));
        set('hoursSub', `24 h · ${wholeHours(t.hunter_minutes)} since ${since}`);
        set('messages24', num(d.messages));
        set('messagesSub', `24 h · ${num(d.ratings)} ratings`);
        set('sinceHead', `counted since ${since}`);
        const history = data.history ?? [];
        if (!history.length) return empty(field('history'), 'No days counted yet.', 6);
        const most = Math.max(1, ...history.map((h: any) => h.hunters ?? 0));
        field('history').replaceChildren(...history.map((h: any) => {
          const hunters = el('span', 'sm-barcell');
          hunters.append(el('strong', '', num(h.hunters)), bar((100 * h.hunters) / most));
          const day = new Date(`${h.date}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
          const peak = h.peak_online ? `${num(h.peak_online)} at ${when(h.peak_at, true, false, true)}` : '–';
          const tr = row([day, hunters, num(h.new_hunters), peak, hours(h.hunter_minutes), num(h.deaths)], 1);
          tr.title = `${num(h.messages)} messages · ${num(h.ratings)} ratings · ${num(h.bells_rung)} bells`;
          return tr;
        }));
      };

      const renderAreas = () => {
        const areas = (data.areas ?? []).filter((a: any) => a.online || a.hunter_minutes || a.deaths || a.footsteps);
        if (!areas.length) {
          set('areaFacts', 'No hunter has set foot anywhere yet.');
          return empty(field('areas'), '–', 8);
        }
        const rate = (a: any) => (a.hunter_minutes >= 30 ? (60 * a.deaths) / a.hunter_minutes : null);
        const top = (key: (a: any) => number) => areas.reduce((best: any, a: any) => (key(a) > key(best) ? a : best), areas[0]);
        const played = top((a) => a.hunter_minutes);
        const deadly = top((a) => a.deaths);
        const rated = areas.filter((a: any) => rate(a) !== null && a.deaths > 0);
        const fastest = rated.length ? rated.reduce((best: any, a: any) => (rate(a)! > rate(best)! ? a : best), rated[0]) : null;
        const strong = (t: string) => el('strong', '', t);
        const facts = el('span');
        facts.append('Most played is ', strong(played.name), ` with ${hours(played.hunter_minutes)} hours.`);
        if (deadly.deaths) facts.append(' Most hunters died in ', strong(deadly.name), `, ${num(deadly.deaths)} times.`);
        if (fastest) facts.append(' But nothing kills as fast as ', strong(fastest.name), `: ${num(fastest.deaths)} deaths in ${num(fastest.hunter_minutes)} minutes.`);
        field('areaFacts').replaceChildren(facts);
        const maxRate = Math.max(1, ...areas.map((a: any) => rate(a) ?? 0));
        const fastestFirst = [...rated].sort((a: any, b: any) => rate(b)! - rate(a)!);
        if (!fastestFirst.length) empty(field('fallRows'), 'No area has had 30 minutes of play yet.');
        else field('fallRows').replaceChildren(...fastestFirst.slice(0, 7).map((a: any) => line([a.name], `${rate(a)!.toFixed(1)} / h`,
          (100 * rate(a)!) / maxRate, true, `${num(a.deaths)} deaths in ${hours(a.hunter_minutes)} h`)));
        field('areas').replaceChildren(...areas.map((a: any) => {
          const r = rate(a);
          const cell = el('span', 'sm-barcell');
          cell.append(el('strong', '', r === null ? '–' : r.toFixed(1)), bar(r === null ? 0 : (100 * r) / maxRate, true));
          const tr = row([a.name, num(a.online), hours(a.hunter_minutes), num(a.deaths), cell, num(a.bells_rung), num(a.messages), num(a.footsteps)], 1);
          if (a.online) tr.classList.add('is-lit');
          return tr;
        }));
      };

      const renderDeaths = (s: any) => {
        const c: Record<string, number> = s.deaths_by_cause ?? {};
        const total = Object.values(c).reduce((sum, n) => sum + Number(n || 0), 0);
        set('causesHead', `${num(total)} deaths`);
        // The causes as one bar split by share, the names with their share below it
        const order = Object.entries(c).filter(([, n]) => Number(n) > 0).sort((a, b) => b[1] - a[1]);
        const split = el('div', 'sm-share');
        split.setAttribute('role', 'img');
        split.setAttribute('aria-label', order.map(([key, n]) => `${causes[key] ?? key} ${total ? Math.round((100 * n) / total) : 0}%`).join(', '));
        const legend = el('p', 'sm-legend');
        order.forEach(([key, n]) => {
          const part = el('span', `sm-cause-${key}`);
          part.style.width = `${total ? (100 * n) / total : 0}%`;
          split.append(part);
          const item = el('span');
          item.append(el('i', `sm-cause-${key}`), `${causes[key] ?? key} ${num(n)} · ${total ? Math.round((100 * n) / total) : 0}%`);
          legend.append(item);
        });
        field('causes').replaceChildren(...(total ? [split, legend] : [el('p', 'sm-empty', 'No deaths yet.')]));
        const killers = data.killers ?? [];
        const worst = Math.max(1, ...killers.map((k: any) => k.deaths));
        if (!killers.length) empty(field('killers'), 'The names of the enemies are coming soon.');
        else field('killers').replaceChildren(...killers.slice(0, 6).map((k: any, i: number) =>
          line([el('span', 'sm-rank', String(i + 1)), k.name], num(k.deaths), (100 * k.deaths) / worst, true)));
        const deaths = data.deaths ?? [];
        if (!deaths.length) empty(field('deaths'), 'No deaths yet. Yharnam is quiet, for now.');
        else field('deaths').replaceChildren(...deaths.slice(0, 6).map((d: any) => {
          const li = el('li', 'sm-stack');
          const line = el('span');
          line.append(hunterLink(hunterUrl, d.player), ` ${death(d)}`);
          li.append(line, el('span', 'sm-meta', `${place(d)} · ${when(d.time)}`));
          return li;
        }));
      };

      const renderBoard = () => {
        field('boardTabs').replaceChildren(...boards.map(([key, label]) => {
          const b = el('button', '', label) as HTMLButtonElement;
          b.type = 'button';
          b.setAttribute('aria-pressed', String(key === board));
          b.addEventListener('click', () => { board = key; renderBoard(); });
          return b;
        }));
        page.querySelectorAll<HTMLButtonElement>('[data-period]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.period === period)));
        const entries = ((period === 'week' ? data.week : data.leaderboards) ?? {})[board] ?? [];
        if (!entries.length) return empty(field('board'), period === 'week' ? 'No one yet this week.' : 'No one yet.');
        field('board').replaceChildren(...entries.map((e: any) => {
          const li = el('li');
          li.append(el('span', 'sm-rank', `#${e.rank}`), hunterLink(hunterUrl, e.name, 'sm-grow'),
            el('strong', '', board === 'minutes_played' ? `${hours(e.value)} h` : num(e.value)));
          return li;
        }));
      };
      page.querySelectorAll<HTMLButtonElement>('[data-period]').forEach((b) => b.addEventListener('click', () => {
        period = b.dataset.period as 'all' | 'week';
        if (data) renderBoard();
      }));

      const renderCommunity = () => {
        const messages = data.messages ?? [];
        if (!messages.length) empty(field('messages'), 'No messages rated yet.');
        else field('messages').replaceChildren(...messages.map((m: any) => {
          const card = el('div', 'sm-message');
          const meta = el('span', 'sm-meta');
          meta.append(`${place(m)} · by `, hunterLink(hunterUrl, m.author), ` · ${when(m.written, false, true)}`);
          card.append(el('span', 'sm-message-text', m.text ?? ''), meta, el('span', 'sm-meta', `${num(m.good)} good · ${num(m.poor)} poor`));
          return card;
        }));
        const t = data.server.totals ?? {};
        set('messageCount', `${num(t.messages)} written · ${num(t.ratings)} ratings`);
        renderBoard();
      };

      const renderChalices = () => {
        const list = data.chalices ?? [];
        if (!list.length) return empty(field('chalices'), 'No glyph shared yet.');
        field('chalices').replaceChildren(...list.slice(0, 8).map((c: any) => {
          const copy = el('button', 'hw-copy sm-copy', 'Copy') as HTMLButtonElement;
          copy.type = 'button';
          copy.dataset.glyph = c.glyph;
          return line([el('code', 'sm-glyph', c.glyph), copy], `depth ${num(c.depth)}`, undefined, false,
            `${c.name ? `${c.name} · ` : ''}made by ${c.maker || 'a hidden hunter'} · ${num(c.visits)} ${c.visits === 1 ? 'visit' : 'visits'} · shared ${when(c.made)}`);
        }));
      };
      // Copy a glyph; where the browser refuses, the glyph is selected for Ctrl+C
      field('chalices').addEventListener('click', (event) => {
        const copy = (event.target as HTMLElement).closest<HTMLButtonElement>('.sm-copy');
        if (!copy) return;
        const select = () => {
          const range = document.createRange();
          range.selectNodeContents(copy.previousElementSibling!);
          getSelection()?.removeAllRanges();
          getSelection()?.addRange(range);
        };
        (navigator.clipboard ? navigator.clipboard.writeText(copy.dataset.glyph!) : Promise.reject()).then(() => {
          copy.textContent = 'Copied';
          setTimeout(() => { copy.textContent = 'Copy'; }, 1500);
        }, select);
      });

      // Hunters online hour by hour, the last 48 hours: the bar is the average, the line on it the most at once
      const renderHours = () => {
        const list = [...(data.online ?? [])].filter((h: any) => h?.hour).sort((a: any, b: any) => a.hour - b.hour);
        const chart = field('hourChart');
        if (!list.length) {
          set('hourHead', '');
          field('hourAxis').replaceChildren();
          chart.removeAttribute('role');
          return chart.replaceChildren(soon('How many hunters were online in every hour of the last two days.'));
        }
        const top = list.reduce((best: any, h: any) => (Number(h.peak) > Number(best.peak) ? h : best), list[0]);
        const most = Math.max(1, Number(top.peak) || 0);
        set('hourHead', `· most at once ${num(top.peak)}, ${when(top.hour)}`);
        chart.setAttribute('role', 'img');
        chart.setAttribute('aria-label', `Hunters online hour by hour from ${when(list[0].hour)} to ${when(list[list.length - 1].hour)}, most at once ${num(top.peak)}`);
        chart.replaceChildren(...list.map((h: any) => {
          const col = el('span', 'sm-col');
          col.style.setProperty('--avg', String((100 * Number(h.average ?? 0)) / most));
          col.style.setProperty('--peak', String((100 * Number(h.peak ?? 0)) / most));
          col.title = `${when(h.hour)}: ${num(Math.round(Number(h.average ?? 0)))} on average, ${num(h.peak)} at most`;
          return col;
        }));
        // The time under every sixth hour
        field('hourAxis').replaceChildren(...list.map((h: any) =>
          el('span', '', new Date(h.hour * 1000).getHours() % 6 === 0 ? when(h.hour, false, false, true) : '')));
      };

      // The map: SuperMedo Server's pictures (without a fitting one, the ground: where hunters have walked) and the
      // hunters there right now as dots without names. One area, or Yharnam: Old Yharnam, Central Yharnam and Cathedral
      // Ward share the game's coordinates and fit together, drawn bottom to top (Upper Cathedral Ward lies over the
      // Cathedral Ward and keeps a view of its own)
      const YHARNAM = ['m23_00', 'm24_01', 'm24_00'];
      const YHARNAM_NAME = 'Yharnam';
      let mapCode = '';
      let layers: any[] | null = null;
      let mapWidth = 0;
      // The areas' pictures, loaded once per visit from the forum: an <img>, or false when one didn't load
      const pictures = new Map<string, HTMLImageElement | false>();
      const showing = (code: string) => !!layers?.some((m) => m.code === code);
      const picture = (code: string) => {
        let img = pictures.get(code);
        if (img === undefined) {
          const loading = new Image();
          loading.addEventListener('load', () => { if (showing(code)) drawMap(); });
          loading.addEventListener('error', () => {
            pictures.set(code, false);
            if (showing(code)) drawMap();
          });
          loading.src = `${page.dataset.src}/map/${encodeURIComponent(code)}/image`;
          pictures.set(code, img = loading);
        }
        return img;
      };
      const onFrame = (frame: any, [x, z]: number[]) => x >= frame.x0 && x <= frame.x1 && z >= frame.z0 && z <= frame.z1;
      // A picture counts where the ground hunters walked lies on it: one area's picture showed another place (1 % of its
      // ground on it, 2.11.2026)
      const fitting = (map: any) => {
        const floor: number[][] = map.floor ?? [];
        return map.image && floor.filter((p) => onFrame(map.image, p)).length >= 0.8 * floor.length ? map.image : null;
      };
      // Hunters only near ground hunters walk, and on the picture: one who has just warped is sometimes filed under the
      // area they left, and such a dot zoomed the map out until the area was gone (in the Hunter's Dream 23 of 96 dots
      // lay in other areas, 2.11.2026)
      const hunters = (map: any, frame: any): number[][] => {
        const floor: number[][] = map.floor ?? [];
        const grid = Number(map.grid) || 1;
        const reach = Math.max(1, Math.ceil(6 / grid));
        const walked = new Set(floor.map(([x, z]) => `${Math.round(x / grid)},${Math.round(z / grid)}`));
        const nearWalked = ([x, z]: number[]) => {
          const [cx, cz] = [Math.round(x / grid), Math.round(z / grid)];
          for (let dx = -reach; dx <= reach; dx++) {
            for (let dz = -reach; dz <= reach; dz++) if (walked.has(`${cx + dx},${cz + dz}`)) return true;
          }
          return false;
        };
        return (map.now ?? []).filter((p: number[]) => (!floor.length || nearWalked(p)) && (!frame || onFrame(frame, p)));
      };
      // Dots, one per spot and bigger where several hunters stand together
      const dots = (ctx: CanvasRenderingContext2D, now: number[][], px: (x: number) => number, py: (z: number) => number, small = false) => {
        const spots = new Map<string, number>();
        now.forEach(([x, z]) => spots.set(`${x},${z}`, (spots.get(`${x},${z}`) ?? 0) + 1));
        spots.forEach((count, key) => {
          const [x, z] = key.split(',').map(Number);
          const r = small ? Math.min(4, 2.2 + Math.sqrt(count - 1)) : Math.min(9, 3.5 + 1.5 * Math.sqrt(count - 1));
          if (!small) {
            ctx.beginPath();
            ctx.arc(px(x), py(z), r + 4, 0, 2 * Math.PI);
            ctx.fillStyle = 'rgba(194, 168, 120, 0.22)';
            ctx.fill();
          }
          ctx.beginPath();
          ctx.arc(px(x), py(z), r, 0, 2 * Math.PI);
          ctx.fillStyle = '#f0ddb0';
          ctx.fill();
          ctx.lineWidth = small ? 1 : 1.5;
          ctx.strokeStyle = '#141518';
          ctx.stroke();
        });
      };
      // A canvas sized for the view, sharp on high-density screens
      const surface = (canvas: HTMLCanvasElement, w: number, h: number) => {
        const ratio = window.devicePixelRatio || 1;
        canvas.width = Math.round(w * ratio);
        canvas.height = Math.round(h * ratio);
        canvas.style.width = `${w}px`;
        canvas.style.height = `${h}px`;
        const ctx = canvas.getContext('2d')!;
        ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
        ctx.clearRect(0, 0, w, h);
        return ctx;
      };
      const drawMap = () => {
        const box = field('map');
        const live = !!layers?.length && layers.every((m) => Array.isArray(m.now));
        field('mapArea').hidden = !live;
        field('mapNote').hidden = !live;
        if (!live) {
          mapWidth = 0;
          return box.replaceChildren(soon('Every hunter online right now as a dot on the map of their area, without a name.'));
        }
        const parts = layers!.map((map) => {
          const frame = fitting(map);
          const img = frame ? picture(map.code) : false;
          return { map, frame, img, drawn: !!img && img.complete && img.naturalWidth > 0, now: hunters(map, frame) };
        });
        // The view: the pictures, else the ground, else the hunters
        let [minX, maxX, minZ, maxZ] = [Infinity, -Infinity, Infinity, -Infinity];
        const take = (x0: number, x1: number, z0: number, z1: number) => {
          [minX, maxX, minZ, maxZ] = [Math.min(minX, x0), Math.max(maxX, x1), Math.min(minZ, z0), Math.max(maxZ, z1)];
        };
        parts.forEach(({ map, frame, now }) => {
          const grid = Number(map.grid) || 1;
          if (frame) take(frame.x0, frame.x1, frame.z0, frame.z1);
          else (map.floor?.length ? map.floor : now).forEach(([x, z]: number[]) => take(x - grid, x + grid, z - grid, z + grid));
        });
        if (!Number.isFinite(minX)) {
          mapWidth = 0;
          return box.replaceChildren(el('p', 'sm-empty', 'Nobody has walked here yet.'));
        }
        // Room for the biggest dot and its glow at the edge (cut in half before)
        const pad = 14;
        mapWidth = box.clientWidth || 600;
        const scale = Math.max(0.01, Math.min((mapWidth - 2 * pad) / (maxX - minX), (520 - 2 * pad) / (maxZ - minZ)));
        const w = Math.max(1, Math.round((maxX - minX) * scale + 2 * pad));
        const h = Math.max(1, Math.round((maxZ - minZ) * scale + 2 * pad));
        let canvas = box.querySelector('canvas');
        if (!canvas) {
          canvas = document.createElement('canvas');
          box.replaceChildren(canvas);
        }
        const ctx = surface(canvas, w, h);
        // z grows downwards, as SuperMedo Server draws its pictures (the walked ground lies on them that way)
        const px = (x: number) => pad + (x - minX) * scale;
        const py = (z: number) => pad + (z - minZ) * scale;
        parts.forEach(({ map, frame, img, drawn }) => {
          if (drawn) {
            // Dimmed, so the dots stand out on its light ground
            ctx.globalAlpha = 0.55;
            ctx.drawImage(img as HTMLImageElement, px(frame.x0), py(frame.z0), (frame.x1 - frame.x0) * scale, (frame.z1 - frame.z0) * scale);
            ctx.globalAlpha = 1;
          } else {
            // The ground, also while the picture loads
            const cell = Math.max(1, (Number(map.grid) || 1) * scale);
            ctx.fillStyle = '#2b2d32';
            (map.floor ?? []).forEach(([x, z]: number[]) => ctx.fillRect(px(x) - cell / 2, py(z) - cell / 2, cell, cell));
          }
        });
        set('mapNote', `Every dot is a hunter online right now, without a name. ${parts.every((p) => p.drawn)
          ? `The map is SuperMedo Server's picture of the ${parts.length > 1 ? 'areas' : 'area'}.` : 'The ground is where hunters have walked.'}`);
        const now = parts.flatMap((p) => p.now);
        dots(ctx, now, px, py);
        const name = parts.length > 1 ? YHARNAM_NAME : parts[0].map.name;
        canvas.setAttribute('role', 'img');
        canvas.setAttribute('aria-label', `${name}: ${num(now.length)} ${now.length === 1 ? 'hunter' : 'hunters'} online right now`);
      };
      const loadMap = async () => {
        const wanted = mapCode;
        const got = await Promise.all((wanted === 'yharnam' ? YHARNAM : [wanted]).map(async (code) => {
          try {
            const response = await fetch(`${page.dataset.src}/map/${encodeURIComponent(code)}`, { credentials: 'omit' });
            return response.ok ? await response.json() : null;
          } catch {
            return null;
          }
        }));
        if (wanted !== mapCode) return; // another pick in the meantime
        const found = got.filter(Boolean);
        layers = found.length ? found : null;
        drawMap();
        drawTiles();
      };
      const pick = (code: string) => {
        mapCode = code;
        field('mapArea').value = code;
        loadMap();
      };

      // Every area at a glance under the big map: its ground and its hunters, the busiest first; a click shows it above
      let tiles: any[] = [];
      const drawTiles = () => {
        const list = field('mapTiles');
        const live = tiles.filter((t) => Array.isArray(t.now));
        list.hidden = !live.length;
        if (!live.length) return list.replaceChildren();
        const city = live.filter((t) => YHARNAM.includes(t.code));
        const shown = [
          // Yharnam's three areas as one, as above (they share the game's coordinates)
          ...(city.length ? [{ code: 'yharnam', name: YHARNAM_NAME, online: city.reduce((n, t) => n + Number(t.online || 0), 0),
            floor: city.flatMap((t) => t.floor ?? []), now: city.flatMap((t) => hunters(t, null)), grid: city[0].grid }] : []),
          ...live.filter((t) => !YHARNAM.includes(t.code)).map((t) => ({ ...t, now: hunters(t, null) })),
        ].sort((a, b) => b.online - a.online || String(a.name).localeCompare(b.name));
        list.replaceChildren(...shown.map((t) => {
          const tile = el('button', 'sm-tile') as HTMLButtonElement;
          tile.type = 'button';
          tile.setAttribute('aria-pressed', String(t.code === mapCode));
          tile.addEventListener('click', () => pick(t.code));
          const canvas = document.createElement('canvas');
          canvas.setAttribute('aria-hidden', 'true');
          const [w, h, pad] = [150, 104, 5];
          const grid = Number(t.grid) || 1;
          let [minX, maxX, minZ, maxZ] = [Infinity, -Infinity, Infinity, -Infinity];
          (t.floor.length ? t.floor : t.now).forEach(([x, z]: number[]) => {
            [minX, maxX, minZ, maxZ] = [Math.min(minX, x - grid), Math.max(maxX, x + grid), Math.min(minZ, z - grid), Math.max(maxZ, z + grid)];
          });
          const ctx = surface(canvas, w, h);
          if (Number.isFinite(minX)) {
            const scale = Math.min((w - 2 * pad) / (maxX - minX), (h - 2 * pad) / (maxZ - minZ));
            // Centred in the tile
            const [ox, oz] = [(w - (maxX - minX) * scale) / 2, (h - (maxZ - minZ) * scale) / 2];
            const px = (x: number) => ox + (x - minX) * scale;
            const py = (z: number) => oz + (z - minZ) * scale;
            const cell = Math.max(1, grid * scale);
            ctx.fillStyle = '#2b2d32';
            t.floor.forEach(([x, z]: number[]) => ctx.fillRect(px(x) - cell / 2, py(z) - cell / 2, cell, cell));
            dots(ctx, t.now, px, py, true);
          }
          tile.append(canvas, el('span', 'sm-tile-name', t.name), el('span', 'sm-tile-count', t.online ? `${num(t.online)} now` : 'nobody now'));
          tile.setAttribute('aria-label', `${t.name}: ${t.online ? `${num(t.online)} hunters online now` : 'nobody online now'}. Show on the map`);
          return tile;
        }));
      };
      const loadTiles = async () => {
        // Only where the forum answers it (it says so in its overview)
        if (!data.mapTiles) {
          tiles = [];
          return drawTiles();
        }
        try {
          const response = await fetch(`${page.dataset.src}/maps`, { credentials: 'omit' });
          tiles = response.ok ? ((await response.json()).areas ?? []) : [];
        } catch {
          tiles = [];
        }
        drawTiles();
      };
      const renderMapAreas = () => {
        const areas = [...(data.maps ?? [])].sort((a: any, b: any) => b.online - a.online || String(a.name).localeCompare(b.name));
        if (!areas.length) {
          layers = null;
          tiles = [];
          drawTiles();
          return drawMap();
        }
        // Yharnam first, when SuperMedo Server knows its three areas, then the busiest area; a visitor's own pick stays
        // through the refreshes
        const city = areas.filter((a: any) => YHARNAM.includes(a.code));
        const views = [...(city.length === YHARNAM.length ? [{ code: 'yharnam', name: `${YHARNAM_NAME} (Central Yharnam, Cathedral Ward, Old Yharnam)`,
          online: city.reduce((n: number, a: any) => n + Number(a.online || 0), 0) }] : []), ...areas];
        if (!views.some((v: any) => v.code === mapCode)) mapCode = views[0].code;
        field('mapArea').replaceChildren(...views.map((a: any) => {
          const option = el('option', '', a.online ? `${a.name} · ${num(a.online)} now` : a.name) as HTMLOptionElement;
          option.value = a.code;
          option.selected = a.code === mapCode;
          return option;
        }));
        loadMap();
        loadTiles();
      };
      field('mapArea').addEventListener('change', (event) => pick((event.target as HTMLSelectElement).value));
      // Drawn again when the page gets narrower or wider, not when the drawing itself changes the height
      new ResizeObserver(() => { if (layers && field('map').clientWidth !== mapWidth) drawMap(); }).observe(field('map'));

      // Invasions: how they end, the latest fights, and the best invaders and defenders
      const pvpBoards: [string, string][] = [['invasions_won', 'Invasions won'], ['hunters_slain', 'Hunters slain'], ['invaders_repelled', 'Invaders repelled']];
      const ends: Record<string, string> = { host_died: 'The host fell', invader_died: 'The invader fell', invader_left: 'The invader left' };
      let pvpBoard = 'invasions_won';
      const renderPvpBoard = () => {
        field('pvpTabs').replaceChildren(...pvpBoards.map(([key, label]) => {
          const b = el('button', '', label) as HTMLButtonElement;
          b.type = 'button';
          b.setAttribute('aria-pressed', String(key === pvpBoard));
          b.addEventListener('click', () => { pvpBoard = key; renderPvpBoard(); });
          return b;
        }));
        const entries = ((data.pvp ?? {}).boards ?? {})[pvpBoard];
        if (!Array.isArray(entries) || !entries.length) {
          return field('pvpBoard').replaceChildren(soon('The best invaders, and the hunters who drive them off.', 'li'));
        }
        const most = Math.max(1, ...entries.map((e: any) => Number(e.value) || 0));
        field('pvpBoard').replaceChildren(...entries.map((e: any, i: number) =>
          line([el('span', 'sm-rank', String(e.rank ?? i + 1)), hunterLink(hunterUrl, e.name)], num(e.value), (100 * (Number(e.value) || 0)) / most)));
      };
      const renderPvp = () => {
        const p = data.pvp ?? {};
        set('pvpSince', p.counting_since ? `counted since ${when(p.counting_since, false, true)}` : '');
        const order = Object.entries((p.results ?? {}) as Record<string, number>).filter(([, n]) => Number(n) > 0).sort((a, b) => b[1] - a[1]);
        const total = order.reduce((sum, [, n]) => sum + Number(n), 0);
        if (!total) field('pvpEnds').replaceChildren(soon('Whether the host falls, the invader falls or the invader leaves.'));
        else {
          // One bar split by share, the outcomes with their share below it
          const split = el('div', 'sm-share');
          split.setAttribute('role', 'img');
          split.setAttribute('aria-label', order.map(([key, n]) => `${ends[key] ?? key} ${Math.round((100 * n) / total)}%`).join(', '));
          const legend = el('p', 'sm-legend');
          order.forEach(([key, n]) => {
            const part = el('span', `sm-end-${key}`);
            part.style.width = `${(100 * n) / total}%`;
            split.append(part);
            const item = el('span');
            item.append(el('i', `sm-end-${key}`), `${ends[key] ?? key} ${num(n)} · ${Math.round((100 * n) / total)}%`);
            legend.append(item);
          });
          field('pvpEnds').replaceChildren(split, legend);
        }
        const recent = p.recent ?? [];
        if (!recent.length) field('pvpRecent').replaceChildren(soon('The latest fights between invaders and hosts.', 'li'));
        else field('pvpRecent').replaceChildren(...recent.slice(0, 6).map((x: any) => {
          const li = el('li', 'sm-stack');
          const who = el('span');
          who.append(hunterLink(hunterUrl, x.invader), ' invaded ', hunterLink(hunterUrl, x.host));
          li.append(who, el('span', 'sm-meta', [ends[x.result] ?? x.result, place(x), when(x.time)].filter(Boolean).join(' · ')));
          return li;
        }));
        renderPvpBoard();
      };

      // The hunt: beasts slain, parries and the like, and bosses; name and number of a list entry, whatever the server
      // calls them
      const deedNames: [string, string][] = [['parry', 'Parries'], ['visceral', 'Visceral attacks'], ['blood_vial_used', 'Blood Vials used'], ['lamp_lit', 'Lamps lit'], ['insight_used', 'Insight used']];
      const entryName = (e: any) => String(e?.name ?? e?.enemy ?? e?.area ?? e?.boss ?? '');
      const entryCount = (e: any) => Number(e?.count ?? e?.value ?? e?.kills ?? e?.slain ?? e?.cleared ?? e?.defeated ?? 0);
      const ranked = (target: string, list: any[], text: string, red = true) => {
        const rows = (list ?? []).filter((e: any) => entryName(e)).sort((a: any, b: any) => entryCount(b) - entryCount(a));
        if (!rows.length) return field(target).replaceChildren(soon(text, 'li'));
        const most = Math.max(1, ...rows.map(entryCount));
        field(target).replaceChildren(...rows.slice(0, 6).map((e: any, i: number) =>
          line([el('span', 'sm-rank', String(i + 1)), entryName(e)], num(entryCount(e)), (100 * entryCount(e)) / most, red)));
      };
      const renderHunt = () => {
        const d = data.deeds ?? {};
        const counts: Record<string, number> = d.deeds ?? {};
        const counted = Number(d.beasts_slain || 0) > 0 || Object.values(counts).some((n) => Number(n) > 0);
        const tile = (label: string, value: number) => {
          const div = el('div');
          const dd = el('dd');
          dd.append(el('strong', '', counted ? num(value) : '–'));
          div.append(el('dt', '', label), dd);
          return div;
        };
        field('deeds').replaceChildren(tile('Beasts slain', d.beasts_slain), ...deedNames.map(([key, label]) => tile(label, counts[key])));
        const since = d.counting_since ? ` since ${when(d.counting_since, false, true)}` : '';
        field('deedsMore').replaceChildren(counted
          ? el('p', 'sm-small', `Also ${num(counts.item_picked_up)} items picked up, ${num(counts.fall_survived)} falls survived and ${num(counts.beast_roar)} Beast Roars${since}.`)
          : soon(`Every beast slain, parry and visceral attack on the server${since ? `, counted${since}` : ''}.`));
        set('beastsHead', counted ? `${num(d.beasts_slain)} in all` : '');
        ranked('beasts', d.by_enemy, 'Which beasts fall most often.');
        ranked('beastAreas', d.by_area, 'Where the most beasts fall.');
        const bosses = data.bosses ?? [];
        set('bossesHead', bosses.length ? `${num(bosses.reduce((sum: number, b: any) => sum + entryCount(b), 0))} times beaten` : '');
        ranked('bosses', bosses, 'Which bosses hunters beat most often.', false);
      };

      const renderHunters = (s: any) => {
        set('registered', num(s.hunters?.registered ?? 0));
        set('playedOnline', num(s.hunters?.played_online ?? 0));
        set('newWeek', num(s.hunters?.new_this_week ?? 0));
        const all = data.hunters ?? [];
        if (!all.length) empty(field('hunters'), 'No hunters yet.', 8);
        else field('hunters').replaceChildren(...(allHunters ? all : all.slice(0, 10)).map((p: any) => {
          const id = el('span', 'sm-who');
          if (p.online) id.append(el('span', 'sm-dot'));
          id.append(hunterLink(hunterUrl, p.name));
          return row([id, num(p.level), hours(p.minutes_played), num(p.deaths), `${num(p.summoned_to_help)} · ${num(p.summons_hosted)}`,
            num(p.invasions), num(p.messages), p.online ? 'online now' : p.last_seen ? when(p.last_seen) : 'not yet'], 1);
        }));
        const more = field('moreHunters') as HTMLButtonElement;
        more.hidden = all.length <= 10;
        more.textContent = allHunters ? 'Show the top 10' : `Show all ${num(all.length)} hunters`;
      };
      field('moreHunters').addEventListener('click', () => {
        allHunters = !allHunters;
        if (data) renderHunters(data.server);
      });

      const state = document.querySelector<HTMLElement>('.sm-state')!;
      const registration: Record<string, string> = { open: 'registration open', discord: 'registration with Discord', closed: 'registration closed' };
      const load = async () => {
        try {
          const response = await fetch(page.dataset.src!, { credentials: 'omit' });
          if (!response.ok) throw new Error(String(response.status));
          data = await response.json();
          const s = data.server;
          const awake = s.status === 'online';
          state.classList.toggle('is-awake', awake);
          set('state', [data.opened ? `Opened ${openedDay(data.opened)}` : '',
            awake ? `online since ${stamp(s.awake_since)}` : 'resting for maintenance, back soon',
            registration[s.registration] ?? '', `updated ${when(data.updatedAt, true)}`].filter(Boolean).join(' · ').replace(/^./, (c) => c.toUpperCase()));
          renderNow(s);
          renderDay(s);
          renderAreas();
          renderDeaths(s);
          renderCommunity();
          renderChalices();
          renderHunters(s);
          renderHours();
          renderPvp();
          renderHunt();
          renderMapAreas();
        } catch {
          state.classList.remove('is-awake');
          set('state', "SuperMedo Server isn't answering right now. The numbers come back by themselves.");
        }
      };

      load();
      // Refresh every minute while the page is visible (the forum caches for a minute as well)
      setInterval(() => {
        if (document.visibilityState === 'visible') load();
      }, 60000);
    }
  </script>
</Base>
