---
import Page from '../layouts/Page.astro';
import { frontmatter } from '../texts/faq.md';

const questions = frontmatter.questions ?? [];
const strip = (html) => html.replace(/<[^>]+>/g, ' ').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();

// Strukturierte Daten für Google (FAQPage)
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: questions.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: strip(a) },
  })),
};
---

<Page frontmatter={frontmatter} jsonLd={[faqLd]}>
  <div class="faq">
    {questions.map(({ q, a }, i) => (
      <details open={i === 0}>
        <summary>{q}</summary>
        <div class="answer" set:html={a} />
      </details>
    ))}
  </div>
</Page>
