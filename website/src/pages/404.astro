---
import Base from '../layouts/Base.astro';
import { link } from '../lib/url.js';
---

<Base title="Page not found" description="This page does not exist." noindex>
  <section class="page-hero not-found">
    <div class="container">
      <h1>You died.</h1>
      <p>This page does not exist (anymore). Return to the lamp:</p>
      <p style="margin-top:1.5rem"><a class="btn btn-primary" href={link()}>Back to the start page</a></p>
    </div>
  </section>
</Base>
