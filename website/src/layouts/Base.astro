---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import { SITE } from '../../site.config.mjs';
import { link, absolute } from '../lib/url.js';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description = SITE.description, jsonLd = [], noindex = false } = Astro.props;
// Search name first on the home page, last on the subpages: this is how Google shows it when searching for "bbport"
const fullTitle = title ? `${title} | ${SITE.brand}` : `${SITE.brand} – ${SITE.name}: Download, Install Guide & Community`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const path = Astro.url.pathname;

// Menu by what visitors look for (Nick, 29.10.2026): get it running, use the launcher, tune it, play online, problems,
// what's new. The addresses stay the same (/guide/ is "Launcher", /server/ is "Online"), so old links keep working.
// Supermedo and Community are in the footer.
const nav = [
  { href: link('install/'), label: 'Install' },
  { href: link('guide/'), label: 'Launcher' },
  { href: link('best-settings/'), label: 'Best settings' },
  { href: link('server/'), label: 'Online' },
  { href: link('faq/'), label: 'FAQ' },
  { href: link('changelog/'), label: 'Changelog' },
  ...(SITE.forumUrl ? [{ href: SITE.forumUrl, label: 'Forum' }] : []),
];

// Site name for Google (appears above the title in the search result)
const baseLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.brand,
  alternateName: SITE.alternateNames,
  url: absolute(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0e10" />
    <link rel="icon" href={link('favicon.png')} type="image/png" sizes="128x128" />
    <link rel="apple-touch-icon" href={link('apple-touch-icon.png')} />
    <link rel="sitemap" href={link('sitemap-index.xml')} />
    <link rel="preload" href={link('fonts/cinzel-latin-700-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={link('fonts/inter-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute('og-image.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([baseLd, ...jsonLd])} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={link()} aria-label={`${SITE.name} – home`}>
          <img src={link('logo.png')} alt={SITE.name} width="172" height="40" />
        </a>
        <input class="menu-input" type="checkbox" id="menu" aria-label="Toggle menu" />
        <label class="menu-button" for="menu"><span aria-hidden="true">☰</span> Menu</label>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
            {SITE.discordUrl && <li class="nav-action"><a class="nav-discord" href={SITE.discordUrl} rel="noopener"><Icon name="discord" />Discord</a></li>}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="cols">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href={link('supermedo/')}>Supermedo</a></li>
            <li><a href={link('community/')}>Community</a></li>
            {SITE.discordUrl && <li><a href={SITE.discordUrl} rel="noopener">Discord</a></li>}
            {SITE.portRepoUrl && <li><a href={SITE.portRepoUrl} rel="noopener">Port on GitHub</a></li>}
            {SITE.supportUrl && <li><a href={SITE.supportUrl} rel="noopener">Support Supermedo</a></li>}
          </ul>
          <ul>
            <li><a href={link('contact/')}>Contact</a></li>
            <li><a href={link('privacy/')}>Privacy</a></li>
          </ul>
        </div>
        <p class="disclaimer">
          {SITE.name} is a community project and is not affiliated with or endorsed by Sony Interactive
          Entertainment or FromSoftware. Bloodborne is a trademark of its respective owners. You need your own
          legally obtained copy of the game – we do not provide or link to game files.
        </p>
        {SITE.contactEmail && <p class="disclaimer">Contact: <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a></p>}
        <p class="disclaimer">Icons by Lorc, Delapouite and Carl Olsen from <a href="https://game-icons.net" rel="noopener">game-icons.net</a>, licensed under CC BY 3.0.</p>
      </div>
    </footer>
    <script>
      // Anchors: a # next to every heading of the text pages (and every FAQ question, see faq.astro) copies
      // the link to exactly that spot. A link to an FAQ question expands it when opened.
      document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((heading) => {
        const anchor = document.createElement('a');
        anchor.className = 'anchor-link';
        anchor.href = `#${heading.id}`;
        anchor.setAttribute('aria-label', `Link to: ${heading.textContent?.trim()}`);
        anchor.textContent = '#';
        heading.append(anchor);
      });

      const openTarget = () => {
        const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
        if (target instanceof HTMLDetailsElement && !target.open) {
          target.open = true;
          target.scrollIntoView();
        }
      };
      openTarget();
      addEventListener('hashchange', openTarget);

      document.addEventListener('click', async (event) => {
        const anchor = event.target instanceof Element ? event.target.closest('.anchor-link') : null;
        if (!(anchor instanceof HTMLAnchorElement)) return;
        // No expanding or collapsing of the FAQ question, no new history entry: just set the address and copy the link
        event.preventDefault();
        const id = anchor.hash.slice(1);
        const target = document.getElementById(id);
        if (target instanceof HTMLDetailsElement) target.open = true;
        history.replaceState(null, '', `#${id}`);
        target?.scrollIntoView();
        try {
          await navigator.clipboard.writeText(`${location.origin}${location.pathname}#${id}`);
          anchor.dataset.copied = '';
          setTimeout(() => delete anchor.dataset.copied, 1500);
        } catch {
          // Without clipboard access, the link is still in the address bar
        }
      });
    </script>
  </body>
</html>
