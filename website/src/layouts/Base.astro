---
import Icon from '../components/Icon.astro';
import '../styles/global.css';
import { SITE } from '../../site.config.mjs';
import { link, absolute } from '../lib/url.js';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description = SITE.description, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} – Install Guide, FAQ & Community`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const path = Astro.url.pathname;

const nav = [
  { href: link('install/'), label: 'Install' },
  { href: link('faq/'), label: 'FAQ' },
  { href: link('changelog/'), label: 'Changelog' },
  ...(SITE.forumUrl ? [{ href: SITE.forumUrl, label: 'Forum' }] : []),
];

const baseLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: absolute(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0d0e10" />
    <link rel="icon" href={link('favicon.png')} type="image/png" sizes="128x128" />
    <link rel="apple-touch-icon" href={link('apple-touch-icon.png')} />
    <link rel="sitemap" href={link('sitemap-index.xml')} />
    <link rel="preload" href={link('fonts/cinzel-latin-700-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={link('fonts/inter-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absolute('og-image.jpg')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify([baseLd, ...jsonLd])} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container">
        <a class="brand" href={link()} aria-label={`${SITE.name} – home`}>
          <img src={link('logo.png')} alt={SITE.name} width="181" height="40" />
        </a>
        <input class="menu-input" type="checkbox" id="menu" aria-label="Toggle menu" />
        <label class="menu-button" for="menu"><span aria-hidden="true">☰</span> Menu</label>
        <nav class="nav" aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
            {SITE.discordUrl && <li><a class="nav-discord" href={SITE.discordUrl} rel="noopener"><Icon name="discord" />Discord</a></li>}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="cols">
          <ul>
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
            <li><a href={link('community/')}>Community</a></li>
            {SITE.discordUrl && <li><a href={SITE.discordUrl} rel="noopener">Discord</a></li>}
          </ul>
          <ul>
            <li><a href={link('imprint/')}>Imprint</a></li>
            <li><a href={link('privacy/')}>Privacy</a></li>
          </ul>
        </div>
        <p class="disclaimer">
          {SITE.name} is a community project and is not affiliated with or endorsed by Sony Interactive
          Entertainment or FromSoftware. Bloodborne is a trademark of its respective owners. You need your own
          legally obtained copy of the game – we do not provide or link to game files.
        </p>
      </div>
    </footer>
  </body>
</html>
