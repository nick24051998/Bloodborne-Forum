---
// Gallery on the home page: tiles in different sizes, images from src/assets/showcase/,
// texts and order from src/texts/showcase.md. Clicking an image opens it large (arrow keys page through).
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { SITE } from '../../site.config.mjs';
import { frontmatter } from '../texts/showcase.md';

const files = import.meta.glob('../assets/showcase/*.{webp,jpg,jpeg,png}', { eager: true });
const byName = Object.fromEntries(Object.entries(files).map(([path, mod]) => [path.split('/').pop(), mod.default]));

// Tile pattern: large, small, small, wide, small, wide, small (fills 4 × 3 on wide screens)
const pattern = ['large', 'small', 'small', 'wide', 'small', 'wide', 'small'];

const items = await Promise.all(
  (frontmatter.items ?? []).map(async (item, i) => {
    const src = item.image ? byName[item.image] : undefined;
    if (item.image && !src) console.warn(`Showcase: Bild ${item.image} fehlt in src/assets/showcase/`);
    // Large view at full resolution up to 3440 px (ultrawide), in high quality so nothing gets blurry when zooming in
    const full = src ? await getImage({ src, width: Math.min(src.width, 3440), format: 'webp', quality: 90 }) : undefined;
    return { ...item, size: pattern[i % pattern.length], src, full: full?.src };
  }),
);
---

{items.length > 0 && (
  <section class="section showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <p class="eyebrow">{frontmatter.eyebrow}</p>
      <h2 id="showcase-heading">{frontmatter.heading}</h2>
      <p class="about">{frontmatter.intro}</p>
      <ul class="showcase-grid">
        {items.map((item) => (
          <li class={`tile tile--${item.size}${item.src ? '' : ' tile--placeholder'}`}>
            {item.src ? (
              <button type="button" class="tile-open" data-full={item.full} data-title={item.title}
                data-text={item.text} data-credit={item.credit} aria-label={`Open image: ${item.title}`}>
                <Image src={item.src} alt={item.alt || item.title} widths={[480, 800, 1200]}
                  sizes="(max-width: 860px) 100vw, 50vw" class="tile-img" loading="lazy" />
              </button>
            ) : (
              <div class="tile-ph" aria-hidden="true">
                <Icon name="crescent" class="tile-ph-icon" />
                <span class="tile-chip">Image coming soon</span>
              </div>
            )}
            <div class="tile-caption">
              <h3>{item.title}</h3>
              {item.text && <p>{item.text}</p>}
              {item.credit && <p class="tile-credit">by {item.credit}</p>}
            </div>
          </li>
        ))}
      </ul>
      {(SITE.forumUrl || SITE.discordUrl) && (
        <p class="showcase-cta">
          {SITE.forumUrl && <a class="btn btn-ghost" href={SITE.forumUrl}>Share yours in the forum</a>}
        </p>
      )}
    </div>

    <dialog class="lightbox" aria-labelledby="lightbox-title">
      <form method="dialog" class="lightbox-close"><button type="submit" aria-label="Close">×</button></form>
      <div class="lightbox-zoom" role="group" aria-label="Zoom">
        <button type="button" class="lightbox-zoom-out" aria-label="Zoom out" disabled>−</button>
        <button type="button" class="lightbox-zoom-in" aria-label="Zoom in">+</button>
      </div>
      <div class="lightbox-stage">
        <img class="lightbox-img" alt="" draggable="false" />
      </div>
      <div class="lightbox-caption">
        <h3 id="lightbox-title"></h3>
        <p class="lightbox-text"></p>
        <p class="lightbox-credit"></p>
        <p class="lightbox-hint">
          <span class="hint-mouse">Click or scroll to zoom, drag to move. Keys: + − 0</span>
          <span class="hint-touch">Tap or pinch to zoom, drag to move.</span>
        </p>
      </div>
      <div class="lightbox-nav">
        <button type="button" class="lightbox-prev" aria-label="Previous image">‹</button>
        <button type="button" class="lightbox-next" aria-label="Next image">›</button>
      </div>
    </dialog>
  </section>
)}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('.tile-open'));
  if (dialog && tiles.length) {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox-img')!;
    const title = dialog.querySelector<HTMLElement>('#lightbox-title')!;
    const text = dialog.querySelector<HTMLElement>('.lightbox-text')!;
    const credit = dialog.querySelector<HTMLElement>('.lightbox-credit')!;
    const nav = dialog.querySelector<HTMLElement>('.lightbox-nav')!;
    const stage = dialog.querySelector<HTMLElement>('.lightbox-stage')!;
    const zoomIn = dialog.querySelector<HTMLButtonElement>('.lightbox-zoom-in')!;
    const zoomOut = dialog.querySelector<HTMLButtonElement>('.lightbox-zoom-out')!;
    let current = 0;

    // Zoom: the image is enlarged via transform (origin top left) and moved within the frame.
    // scale 1 = fitted; highest level = full resolution of the file (at least 2×, at most 6×).
    let scale = 1;
    let x = 0;
    let y = 0;
    const maxScale = () => {
      const w = img.clientWidth;
      const h = img.clientHeight;
      if (!img.naturalWidth || !w || !h) return 2;
      const shown = Math.min(w, (h * img.naturalWidth) / img.naturalHeight); // object-fit: contain
      return Math.max(2, Math.min(6, img.naturalWidth / shown));
    };
    const apply = () => {
      const w = stage.clientWidth;
      const h = stage.clientHeight;
      x = Math.min(0, Math.max(w - w * scale, x));
      y = Math.min(0, Math.max(h - h * scale, y));
      img.style.transform = scale > 1 ? `translate(${x}px, ${y}px) scale(${scale})` : '';
      stage.classList.toggle('is-zoomed', scale > 1);
      zoomOut.disabled = scale <= 1;
      zoomIn.disabled = scale >= maxScale() - 0.01;
    };
    // Zooms so that the point (px, py) in the frame stays at the same spot
    const zoomTo = (target: number, px = stage.clientWidth / 2, py = stage.clientHeight / 2) => {
      const next = Math.min(maxScale(), Math.max(1, target));
      x = px - (px - x) * (next / scale);
      y = py - (py - y) * (next / scale);
      scale = next;
      if (scale === 1) { x = 0; y = 0; }
      apply();
    };
    const reset = () => { scale = 1; x = 0; y = 0; apply(); };
    const point = (e: { clientX: number; clientY: number }) => {
      const r = stage.getBoundingClientRect();
      return [e.clientX - r.left, e.clientY - r.top] as const;
    };

    // Dragging moves the visible area, two fingers zoom
    const pointers = new Map<number, { x: number; y: number }>();
    let moved = 0;
    let pinchStart = 0;
    let pinchScale = 1;
    stage.addEventListener('pointerdown', (e) => {
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      stage.setPointerCapture(e.pointerId);
      moved = 0;
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        pinchStart = Math.hypot(a.x - b.x, a.y - b.y) || 1;
        pinchScale = scale;
      }
    });
    stage.addEventListener('pointermove', (e) => {
      const last = pointers.get(e.pointerId);
      if (!last) return;
      const dx = e.clientX - last.x;
      const dy = e.clientY - last.y;
      pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      moved += Math.abs(dx) + Math.abs(dy);
      if (moved > 2) stage.classList.add('is-dragging');
      if (pointers.size === 2) {
        const [a, b] = [...pointers.values()];
        const [mx, my] = point({ clientX: (a.x + b.x) / 2, clientY: (a.y + b.y) / 2 });
        zoomTo((pinchScale * Math.hypot(a.x - b.x, a.y - b.y)) / pinchStart, mx, my);
      } else if (scale > 1) {
        x += dx;
        y += dy;
        apply();
      }
    });
    const release = (e: PointerEvent) => {
      pointers.delete(e.pointerId);
      if (!pointers.size) stage.classList.remove('is-dragging');
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);
    // Click without dragging: zoom to full resolution at that spot, the next click zooms back out
    stage.addEventListener('click', (e) => {
      if (moved > 6) return;
      if (scale > 1) reset();
      else zoomTo(maxScale(), ...point(e));
    });
    stage.addEventListener('wheel', (e) => {
      e.preventDefault();
      zoomTo(scale * (e.deltaY < 0 ? 1.25 : 0.8), ...point(e));
    }, { passive: false });
    zoomIn.addEventListener('click', () => zoomTo(scale * 1.5));
    zoomOut.addEventListener('click', () => zoomTo(scale / 1.5));
    img.addEventListener('load', apply);

    const show = (index: number) => {
      current = (index + tiles.length) % tiles.length;
      const t = tiles[current].dataset;
      reset();
      img.src = t.full ?? '';
      img.alt = t.title ?? '';
      title.textContent = t.title ?? '';
      text.textContent = t.text ?? '';
      credit.textContent = t.credit ? `by ${t.credit}` : '';
    };

    nav.hidden = tiles.length < 2;
    tiles.forEach((tile, i) => tile.addEventListener('click', () => { show(i); dialog.showModal(); }));
    dialog.querySelector('.lightbox-prev')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.lightbox-next')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === '+' || e.key === '=') zoomTo(scale * 1.5);
      if (e.key === '-') zoomTo(scale / 1.5);
      if (e.key === '0') reset();
    });
    dialog.addEventListener('close', reset);
    // Clicking next to the image closes it
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }
</script>
