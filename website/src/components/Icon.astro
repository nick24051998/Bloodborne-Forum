---
// Icons from media/icons (game-icons.net, CC BY 3.0; Discord: Simple Icons, CC0; see media/CREDITS.md), embedded as SVG; color = text color
import { icons } from '../lib/icons.js';

const { name, class: className } = Astro.props;
---

<span class:list={['bbicon', className]} aria-hidden="true" set:html={icons[name]} />
